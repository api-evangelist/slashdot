        },
        {
          "info": {
            "name": "Get Games Feed",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rss.slashdot.org/Slashdot/slashdotGames"
          },
          "docs": "Returns the Slashdot Games section RSS feed with stories about video games, gaming hardware, and the gaming industry."
        },
        {
          "info": {
            "name": "Get Science Feed",
            "type": "http"
          },
          "http": {
            "method": "GET",
